<%- include("./partials/header.ejs") %>

<div class="entry-entry">
    <div class="portal">
        <img src="/images/spinning-book.gif">
        <form action="/writ/submit" id="entry-form" method="post">
            <label for="date">Date</label>
            <input class="entry-info" id="date" type="date" name="date" value=<%= date %> >
            <label for="entry">Entry</label>
            <textarea class="entry-info" id="entry" type="text" name="entry" placeholder="write here..."></textarea>
            <label for="tldr">tldr</label>
            <input  class="entry-info" id="tldr" type="text" name="tldr" placeholder="Summarize in 30 chars" maxlength="30">
            <button type="submit" value="Submit">Submit</button> 
        </form>
        <img src="/images/spinning-book.gif">
    </div>
</div>

<%- include("./partials/footer.ejs") %>