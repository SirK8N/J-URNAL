{
  "name": "journal-application",
  "version": "1.0.0",
  "description": "This is a journal app for capstone 3",
  "license": "ISC",
  "author": "Kaden Trigueiro",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "electron": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "body-parser": "^2.3.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "fs": "^0.0.1-security"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.kadentrigueiro.journal",
    "productName": "Journal",
    "files": [
      "main.js",
      "index.js",
      "views/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  }
